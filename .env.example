# ── SLBF environment variables ───────────────────────────────────────────────
# Copy to .env for local development. Production values are set in the host's
# environment, never in a file (SDR §14, §15).
#
# Anything marked REQUIRED must be set before the app will start correctly.

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. SQLite locally; Postgres in production, which also means changing
# `provider` in prisma/schema.prisma and the adapter in src/lib/db.ts.
DATABASE_URL="file:./dev.db"

# ── Secrets ──────────────────────────────────────────────────────────────────
# REQUIRED. Generate per environment with: openssl rand -base64 48
# TICKET_SECRET signs the HMAC in every QR e-ticket. Rotating it invalidates
# every ticket already issued, so rotate it between events, not during one.
AUTH_SECRET=""
TICKET_SECRET=""

# REQUIRED. Absolute public URL — used in emails, QR links and canonical tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Payments (FR-07) ─────────────────────────────────────────────────────────
# "sandbox" simulates the full authorise → webhook → confirm cycle with no
# external calls. "live" requires every variable below; the app fails at start-up
# rather than silently taking registrations it cannot collect on.
PAYMENTS_MODE="sandbox"

ORANGE_MONEY_BASE_URL=""
ORANGE_MONEY_MERCHANT_ID=""
ORANGE_MONEY_API_KEY=""
ORANGE_MONEY_WEBHOOK_SECRET=""

AFRIMONEY_BASE_URL=""
AFRIMONEY_MERCHANT_ID=""
AFRIMONEY_API_KEY=""
AFRIMONEY_WEBHOOK_SECRET=""

# Card payments use the PSP's hosted page. No card data reaches this
# application and none is ever stored (NFR-06).
CARD_PSP_BASE_URL=""
CARD_PSP_PUBLIC_KEY=""
CARD_PSP_SECRET_KEY=""
CARD_PSP_WEBHOOK_SECRET=""

# ── Communications (FR-08) ───────────────────────────────────────────────────
# Messages are written to the message_outbox table first and dispatched second.
# "log" records and logs them; "http" POSTs to the provider endpoint below.
MAIL_MODE="log"
MAIL_FROM="no-reply@slbf.sl"
MAIL_API_URL=""
MAIL_API_KEY=""

SMS_MODE="log"
SMS_SENDER_ID="SLBF"
SMS_GATEWAY_URL=""
SMS_GATEWAY_KEY=""

# Where staff notifications go (new enquiries, offline payments to reconcile).
SECRETARIAT_EMAIL="secretariat@slbf.sl"
